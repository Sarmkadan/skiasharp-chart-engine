<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <!-- CS0436: benchmark Program.cs shadows the Program type exposed by the main assembly (top-level Program.cs). Pre-existing; the local type is the one used. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <AssemblyName>skiasharp-chart-engine.Benchmarks</AssemblyName>
    <RootNamespace>SkiaSharpChartEngine.Benchmarks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="6.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../skiasharp-chart-engine.csproj" />
  </ItemGroup>

</Project>
